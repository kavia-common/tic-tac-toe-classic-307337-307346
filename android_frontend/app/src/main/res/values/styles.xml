<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.TTT.Title" parent="@android:style/TextAppearance.Medium">
        <item name="android:textSize">@dimen/ttt_text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ttt_text</item>
    </style>

    <style name="TextAppearance.TTT.Body" parent="@android:style/TextAppearance.Small">
        <item name="android:textSize">@dimen/ttt_text_body</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/ttt_secondary</item>
    </style>

    <style name="Widget.TTT.RestartButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/ttt_primary_button_bg</item>
        <item name="android:textColor">@color/ttt_surface</item>
        <item name="android:textSize">@dimen/ttt_text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/ttt_button_height</item>
        <item name="android:paddingLeft">@dimen/ttt_card_padding</item>
        <item name="android:paddingRight">@dimen/ttt_card_padding</item>
    </style>

    <style name="Widget.TTT.SecondaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/ttt_surface_card</item>
        <item name="android:textColor">@color/ttt_text</item>
        <item name="android:textSize">@dimen/ttt_text_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/ttt_button_height</item>
        <item name="android:paddingLeft">@dimen/ttt_card_padding</item>
        <item name="android:paddingRight">@dimen/ttt_card_padding</item>
    </style>

    <style name="TextAppearance.TTT.ScoreValue" parent="@android:style/TextAppearance.Medium">
        <item name="android:textSize">@dimen/ttt_text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ttt_text</item>
    </style>

</resources>
