<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled: reduce emphasis -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ttt_surface" />
            <corners android:radius="@dimen/ttt_cell_radius" />
            <stroke android:width="1dp" android:color="@color/ttt_border" />
        </shape>
    </item>

    <!-- Pressed: primary accent outline -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ttt_surface" />
            <corners android:radius="@dimen/ttt_cell_radius" />
            <stroke android:width="2dp" android:color="@color/ttt_primary" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ttt_surface" />
            <corners android:radius="@dimen/ttt_cell_radius" />
            <stroke android:width="1dp" android:color="@color/ttt_border" />
        </shape>
    </item>
</selector>
