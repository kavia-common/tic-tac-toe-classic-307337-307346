<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed: stronger border -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#EEF2FF" />
            <corners android:radius="@dimen/ttt_cell_radius" />
            <stroke android:width="2dp" android:color="@color/ttt_primary" />
        </shape>
    </item>

    <!-- Disabled: slightly muted -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#E0F2FE" />
            <corners android:radius="@dimen/ttt_cell_radius" />
            <stroke android:width="1dp" android:color="@color/ttt_border" />
        </shape>
    </item>

    <!-- Default (face-down) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F1F5F9" />
            <corners android:radius="@dimen/ttt_cell_radius" />
            <stroke android:width="1dp" android:color="@color/ttt_border" />
        </shape>
    </item>
</selector>
